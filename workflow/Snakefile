# ACID pipeline: raw .nd2 acquisitions -> per-object feature tables.
#
# Usage (from the repository root):
#
#   uv run --frozen --group pipeline snakemake -s workflow/Snakefile \
#       --config acid_config=configs/exp_001.yaml --profile workflow/profiles/local
#
# Add -n for a dry run; run the same command again to continue after a failure.
#
# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
# The only Snakemake setting is `acid_config`: the experiment file the
# notebooks use (configs/<id>.yaml, merged over src/acid/config/default.yaml
# by `load_config`). Every path and scientific parameter comes from it.
# Compute resources (partition, memory, runtime, GPU) come from the profile
# in workflow/profiles/, never from the ACID configuration.
#
# ---------------------------------------------------------------------------
# What runs (notebook -> rules)
# ---------------------------------------------------------------------------
#   part0  extract_acquisition   one job per raw .nd2 file
#          merge_extraction      -> ACID_metadata_part_1.csv
#   part1  split (checkpoint)    -> ACID_metadata_part_2.csv
#   part2  measure_quality       one job per training FOV
#          flag_quality          -> ACID_metadata_part_3.csv + QC graphs
#   part3  background_function   one job, uses all unflagged FOVs
#                                -> ACID_metadata_part_4a.csv
#   part4  correct_background    one job per training FOV
#          merge_background_correction -> ACID_metadata_part_4b.csv
#   part5  segment               one job per training FOV (GPU)
#          merge_segmentation    -> ACID_metadata_part_5.csv
#   part6  extract_features      one job per training FOV
#          merge_features        -> ACID_metadata_part_6.csv (target of `all`)
#
# Every rule runs `python -m acid.pipeline <command>` (src/acid/pipeline/cli.py),
# which calls one function of acid.pipeline.fov_jobs (per-FOV jobs) or
# acid.pipeline.merge_jobs (whole-stage and merge jobs).
#
# ---------------------------------------------------------------------------
# How per-FOV jobs fit together
# ---------------------------------------------------------------------------
# - A FOV is named by its extracted file name without ".ome.tif"; this name
#   is the {fov} wildcard (acid.pipeline.records.fov_name).
# - Each per-FOV job reads the merged metadata CSV of the previous stage,
#   processes its one row and writes a JSON result record to
#   <output_root>/work/<stage>/<fov>.json. Image outputs go to the usual
#   folders (corrected_fov/, segmentation_masks/, feature_tables/).
# - The merge rule of the stage collects all records and writes them into
#   the next metadata CSV, which the next stage's FOV jobs read. So every
#   stage finishes for all FOVs before the next one starts.
# - The FOV list is only known after extraction, so `split` is a checkpoint:
#   once it has run, Snakemake reads part_2.csv and adds the FOV jobs.
# - Metadata names have no date prefix (unlike the notebooks' files), so the
#   output names do not change from day to day.

from pathlib import Path

import pandas as pd
from snakemake.logging import logger

from acid.config import load_config, prepare_output
from acid.image_processing.fov_extraction import discover_acquisitions
from acid.pipeline.records import list_fov_names, select_stage_rows
from acid.utils.metadata.saving import build_undated_metadata_dataframe_filename


# ---------------------------------------------------------------------------
# Load the ACID configuration
# ---------------------------------------------------------------------------

if "acid_config" not in config:
    raise ValueError(
        "Pass the ACID configuration: --config acid_config=configs/<id>.yaml"
    )

ACID_CONFIG = config["acid_config"]
# Relative paths in the ACID config are resolved from the repository root
# (the parent of workflow/); tests pass another root with project_root=...
ROOT = Path(config.get("project_root", Path(workflow.basedir).parent)).resolve()
CFG = load_config(ACID_CONFIG, project_root=ROOT, preview=False)

OUTPUT_ROOT = Path(CFG.shared.output_root)
WORK = OUTPUT_ROOT / "work"  # per-acquisition CSVs and per-FOV JSON records
LOGS = OUTPUT_ROOT / "logs"  # one log file per job
# Command prefix of every rule; the job loads the same config with the same root.
ACID = f"python -m acid.pipeline --project-root {ROOT}"


# ---------------------------------------------------------------------------
# Metadata files of the stages
# ---------------------------------------------------------------------------


def metadata_path(stage):
    """Undated metadata CSV written by a stage, e.g. ACID_metadata_part_3.csv.

    Directory and name parts come from `<stage>.metadata` in the ACID config.
    """
    metadata = CFG[stage].metadata
    name = build_undated_metadata_dataframe_filename(
        metadata.saving, CFG.project_identity.project_name
    )
    return str(Path(metadata.directory) / name)


PART_1 = metadata_path("field_of_view_extraction")  # all extracted FOVs
PART_2 = metadata_path("dataset_splitting")  # + treatment, train/test split
PART_3 = metadata_path("quality_control")  # training FOVs + QC values and flag
PART_4A = metadata_path("background_function_calculation")  # + background settings
PART_4B = metadata_path("background_correction")  # + corrected file names
PART_5 = metadata_path("object_segmentation")  # + segmentation mask names
PART_6 = metadata_path("feature_extraction")  # + feature table names


# ---------------------------------------------------------------------------
# FOV list (known only after the `split` checkpoint)
# ---------------------------------------------------------------------------


def fov_names():
    """FOVs of the training split; available once the `split` checkpoint ran.

    `checkpoints.split.get()` makes Snakemake wait for the checkpoint and
    re-evaluate the DAG afterwards. The selection is the same as in every
    per-FOV job (`select_stage_rows`), so the records match the rows.
    """
    part_2 = checkpoints.split.get().output[0]
    rows = select_stage_rows(pd.read_csv(part_2), "quality_control", CFG)
    return list_fov_names(rows, CFG)


def fov_records(step):
    """Input function of a merge rule: the JSON record of every FOV of `step`.

    Requesting these files makes Snakemake run the per-FOV rule whose output
    is work/<step>/{fov}.json once for each FOV.
    """

    def records(wildcards):
        return [str(WORK / step / f"{fov}.json") for fov in fov_names()]

    return records


# ---------------------------------------------------------------------------
# Start of a run
# ---------------------------------------------------------------------------

onstart:
    # Writes config.resolved.yaml, or stops if the output folder was made
    # with different settings (same check as in every notebook). Not run in
    # dry runs.
    prepare_output(CFG)


# ---------------------------------------------------------------------------
# Target and rules
# ---------------------------------------------------------------------------


# Default target: the final metadata, which needs every stage before it.
rule all:
    input:
        PART_6,


# Light jobs (CSV merges, train/test split, QC graphs) run in the Snakemake
# main process instead of being submitted to SLURM.
localrules:
    all,
    merge_extraction,
    split,
    flag_quality,
    merge_background_correction,
    merge_segmentation,
    merge_features,


include: "rules/extraction.smk"  # part0, part1
include: "rules/quality.smk"  # part2
include: "rules/background.smk"  # part3, part4
include: "rules/segmentation.smk"  # part5
include: "rules/features.smk"  # part6
